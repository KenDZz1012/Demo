[Oo]bj/
[Ll]og/
[Ll]ogs/
TestResults/
out/
Generated\ Files/

# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Include if using Publish profiles
*.Publish.xml
*.pubxml
*.publishsettings

# Visual Studio Code
.vscode/
*.code-workspace

# Rider
.idea/
*.sln.iml

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# DotCover
*.dotCover

# Backup & report files
*.nupkg
*.snupkg
*.log
*.vspscc
*.vssscc

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Visual Studio workspace
.vs/

# Others
*.dbmdl
*.jfm
_ReSharper*/
*.DotSettings.user

# Windows image file caches
Thumbs.db
ehthumbs.db

# Windows shortcuts
*.lnk

# Node.js dependencies (if using in ASP.NET Core)
node_modules/
