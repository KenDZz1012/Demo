{
  "Routes": [
    //Authorize
    {
      "DownstreamPathTemplate": "/v1/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "authorize",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/au/{url}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT" ]
    },

    //Catalog api
    {
      "DownstreamPathTemplate": "/v1/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "catalog.api",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/ca/{url}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT" ]
    },

    //Patient api
    {
      "DownstreamPathTemplate": "/v1/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "patient.api",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/pr/{url}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "host.docker.internal:7001"
  }
}
