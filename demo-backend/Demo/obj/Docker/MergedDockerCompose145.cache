name: dockercompose1562752333064575907
services:
  apigateway:
    build:
      context: C:\Personal\demo-backend\Demo
      dockerfile: ApiGateway/ApiGateway/Dockerfile
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: ApiGateway
      target: base
    container_name: ApiGateway
    entrypoint:
      - tail
      - -f
      - /dev/null
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_LOGGING__CONSOLE__DISABLECOLORS: "true"
      ASPNETCORE_URLS: http://+:80
      DOTNET_USE_POLLING_FILE_WATCHER: "1"
      NUGET_FALLBACK_PACKAGES: ""
    image: kendz/apigateway:dev
    labels:
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /root/.nuget/packages  "/app/bin/Debug/net6.0/ApiGateway.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: /bin/sh -c "if PID=$$(pidof dotnet); then kill $$PID; fi"
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        published: "9874"
        protocol: tcp
    restart: unless-stopped
    tty: true
    volumes:
      - type: bind
        source: /c/Users/kien.nt1/AppData/Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: /c/Users/kien.nt1/AppData/Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: /c/Personal/demo-backend/Demo/ApiGateway/ApiGateway
        target: /app
        bind:
          create_host_path: true
      - type: bind
        source: /c/Personal/demo-backend/Demo
        target: /src
        bind:
          create_host_path: true
      - type: bind
        source: /c/Users/kien.nt1/vsdbg/vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: /c/Users/kien.nt1/.nuget/packages/
        target: /root/.nuget/packages
        read_only: true
        bind:
          create_host_path: true
  authorize:
    build:
      context: C:\Personal\demo-backend\Demo
      dockerfile: Authorize/Authorize/Dockerfile
      labels:
        com.microsoft.created-by: visual-studio
