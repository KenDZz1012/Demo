      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        protocol: tcp
    restart: unless-stopped
    tty: true
    volumes:
      - type: bind
        source: /c/Personal/demo-backend/Demo/Authorize/Authorize
        target: /app
        bind:
          create_host_path: true
      - type: bind
        source: /c/Personal/demo-backend/Demo
        target: /src
        bind:
          create_host_path: true
      - type: bind
        source: /c/Users/kien.nt1/vsdbg/vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: /c/Users/kien.nt1/.nuget/packages/
        target: /root/.nuget/packages
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: /c/Users/kien.nt1/AppData/Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: /c/Users/kien.nt1/AppData/Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
  catalog.api:
    build:
      context: C:\Personal\demo-backend\Demo
      dockerfile: Services/Catalog/Catalog.API/Dockerfile
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: Catalog.API
      target: base
    container_name: Catalog.API
    entrypoint:
      - tail
      - -f
      - /dev/null
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_LOGGING__CONSOLE__DISABLECOLORS: "true"
      ASPNETCORE_URLS: http://+:80
      DOTNET_USE_POLLING_FILE_WATCHER: "1"
      NUGET_FALLBACK_PACKAGES: ""
      SQL_CONNECTION: Server=lisdb;Database=Catalog;User Id=sa;Password=Kienteo1012;TrustServerCertificate=True
    image: kendz/catalogapi:dev
    labels:
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /root/.nuget/packages  "/app/bin/Debug/net6.0/Catalog.API.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: /bin/sh -c "if PID=$$(pidof dotnet); then kill $$PID; fi"
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        protocol: tcp
    restart: unless-stopped
    tty: true
    volumes:
      - type: bind
        source: /c/Personal/demo-backend/Demo/Services/Catalog/Catalog.API
        target: /app
        bind:
          create_host_path: true
      - type: bind
        source: /c/Personal/demo-backend/Demo
        target: /src
        bind:
          create_host_path: true
      - type: bind
        source: /c/Users/kien.nt1/vsdbg/vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: /c/Users/kien.nt1/.nuget/packages/
        target: /root/.nuget/packages
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: /c/Users/kien.nt1/AppData/Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: /c/Users/kien.nt1/AppData/Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
  lisdb:
    container_name: lisdb
    environment:
      ACCEPT_EULA: "Y"
      SA_PASSWORD: Kienteo1012
    image: mcr.microsoft.com/mssql/server:2019-latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1433
        published: "1433"
        protocol: tcp
    restart: always
    user: root
    volumes:
      - type: volume
        source: lisdb-data
        target: /var/opt/mssql/data
        volume: {}
  minio:
    command:
      - server
      - --console-address
      - :9001
      - /data
    container_name: minio
    environment:
      MINIO_ROOT_PASSWORD: kienteo1012
      MINIO_ROOT_USER: kendz
    image: minio/minio
    networks:
      default: null
    ports:
      - mode: ingress
        target: 9000
        published: "9000"
        protocol: tcp
      - mode: ingress
        target: 9001
        published: "9001"
        protocol: tcp
    restart: always
    volumes:
      - type: bind
        source: /c/Personal/demo-backend/Demo/storage
        target: /data
        bind:
          create_host_path: true
  patient.api:
    build:
      context: C:\Personal\demo-backend\Demo
      dockerfile: Services/Patient/Patient.API/Dockerfile
      labels:
        com.microsoft.created-by: visual-studio
