name: dockercompose1562752333064575907
services:
  apigateway:
    build:
      context: C:\Personal\demo-backend\Demo
      dockerfile: ApiGateway/ApiGateway/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:80
    image: apigateway
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        published: "9874"
        protocol: tcp
    volumes:
      - type: bind
        source: /c/Users/kien.nt1/AppData/Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: /c/Users/kien.nt1/AppData/Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
  authorize:
    build:
      context: C:\Personal\demo-backend\Demo
      dockerfile: Authorize/Authorize/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:80
    image: authorize
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        protocol: tcp
  catalog.api:
    build:
      context: C:\Personal\demo-backend\Demo
      dockerfile: Services/Catalog/Catalog.API/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:80
      SQL_CONNECTION: Server=orderdb;Database=OrderDb;User Id=sa;Password=Ken12345678
    image: catalogapi
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        protocol: tcp
  catalogdb:
    container_name: catalogdb
    environment:
      ACCEPT_EULA: "Y"
      SA_PASSWORD: Ken12345678
    image: mcr.microsoft.com/mssql/server:2019-latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1433
        published: "1433"
        protocol: tcp
    restart: always
  patient.api:
    build:
      context: C:\Personal\demo-backend\Demo
      dockerfile: Services/Patient/Patient.API/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:80
    image: patientapi
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        protocol: tcp
networks:
  default:
    name: dockercompose1562752333064575907_default