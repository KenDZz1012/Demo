        target: /app
        bind:
          create_host_path: true
      - type: bind
        source: D:\Personal\Developer\Demo\demo-backend\Demo
        target: /src
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\KenDz\vsdbg\vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\KenDz\.nuget\packages
        target: /.nuget/packages
        read_only: true
        bind:
          create_host_path: true
      - type: bind
