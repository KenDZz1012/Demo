      - type: bind
        source: C:\Users\KenDz\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\KenDz\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
  lisdb:
    container_name: lisdb
    environment:
      ACCEPT_EULA: "Y"
      SA_PASSWORD: Kienteo1012
    image: mcr.microsoft.com/mssql/server:2019-latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1433
        published: "1433"
        protocol: tcp
    restart: always
    user: root
    volumes:
      - type: volume
        source: lisdb-data
        target: /var/opt/mssql/data
        volume: {}
  minio:
    command:
      - server
      - --console-address
      - :9001
      - /data
    container_name: minio
    environment:
      MINIO_ROOT_PASSWORD: kienteo1012
      MINIO_ROOT_USER: kendz
    image: minio/minio
    networks:
      default: null
    ports:
      - mode: ingress
        target: 9000
        published: "9000"
        protocol: tcp
      - mode: ingress
        target: 9001
        published: "9001"
        protocol: tcp
    restart: always
    volumes:
      - type: bind
        source: D:\Personal\Developer\Demo\demo-backend\Demo\storage
        target: /data
        bind:
          create_host_path: true
  patient.api:
