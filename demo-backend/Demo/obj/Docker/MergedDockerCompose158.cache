name: dockercompose17419331674151111945
services:
  apigateway:
    build:
      context: D:\Personal\Developer\Demo\demo-backend\Demo
      dockerfile: ApiGateway/ApiGateway/Dockerfile
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: ApiGateway
    container_name: ApiGateway
    entrypoint:
      - tail
      - -f
      - /dev/null
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:80
    image: kendz/apigateway
    labels:
      com.microsoft.visual-studio.project-name: ApiGateway
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /root/.nuget/packages  "/app/ApiGateway.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: /bin/sh -c "if PID=$$(pidof dotnet); then kill $$PID; fi"
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        published: "9874"
        protocol: tcp
    restart: unless-stopped
    tty: true
    volumes:
      - type: bind
        source: C:\Users\KenDz\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\KenDz\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\kien.nt1\vsdbg\vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
  authorize:
    build:
      context: D:\Personal\Developer\Demo\demo-backend\Demo
      dockerfile: Authorize/Authorize/Dockerfile
      labels:
